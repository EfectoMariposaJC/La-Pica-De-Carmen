<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Panel - Tus locales</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="dashboard-wrap">
    <h1>Tus locales</h1>
    <div class="location-grid">
      <% locations.forEach(function(loc) { %>
        <a class="location-card" href="/dashboard/<%= loc.slug %>">
          <h2><%= loc.name %></h2>
          <p><%= loc.totalCustomers %> clientes registrados</p>
        </a>
      <% }); %>
    </div>
  </div>
</body>
</html>
